{
  "git": {
    "requireCleanWorkingDir": true,
    "commitMessage": "Release ${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release ${version}"
  },
  "plugins": {
    "@release-it/keep-a-changelog": {
      "filename": "CHANGELOG.md"
    }
  },
  "github": {
    "release": true,
    "releaseName": "Release ${version}",
    "assets": [
      "fabric/build/libs/*.jar",
      "neoforge/build/libs/*.jar"
    ]
  },
  "hooks": {
    "after:bump": "chmod +x ./gradlew && ./gradlew build",
    "after:release": "npx tsx scripts/publish-modrinth.ts --version ${version} --project-id \"$MODRINTH_PROJECT_ID\" --game-versions \"$MODRINTH_GAME_VERSIONS\" --loaders \"$MODRINTH_LOADERS\" --file fabric/build/libs/*.jar --file neoforge/build/libs/*.jar"
  }
}
